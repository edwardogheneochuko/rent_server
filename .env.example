# Copy this file to .env and fill in real values.
#   cp .env.example .env      (Mac/Linux/Git Bash)
#   copy .env.example .env    (Windows CMD)

# "development" or "production"
NODE_ENV=development

# Port the API listens on
PORT=5000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/rentright
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rentright?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/rentright

# Optional. If connecting to Atlas fails with "querySrv ECONNREFUSED",
# tell Node to use public DNS servers. Leave empty otherwise.
DNS_SERVERS=

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# How long a login lasts (jsonwebtoken format: 7d, 12h, 30m ...)
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed to call this API (comma-separated, no trailing slash)
CLIENT_URL=http://localhost:5173

# Used only by `npm run create-admin` to create the first admin account
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@rentright.ng
ADMIN_PASSWORD=ChangeMe123

# Cloudinary (needed from Phase 5 — leave blank for now)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
